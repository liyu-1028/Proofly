# =============================================================================
# Proofly 环境变量模板
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略）
# =============================================================================

# ---------- 服务端口 ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=proofly_dev
MYSQL_DATABASE=proofly
DB_URL=jdbc:mysql://localhost:3306/proofly?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=proofly_dev

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- MinIO ----------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=proofly

# ---------- 鉴权 ----------
# JWT 签名密钥：生产环境必须 ≥ 32 字节随机串，禁止使用默认值
PROOFLY_AUTH_JWT_SECRET=please-replace-with-a-random-32-byte-secret
PROOFLY_AUTH_ACCESS_TOKEN_TTL_MINUTES=120
PROOFLY_AUTH_REFRESH_TOKEN_TTL_DAYS=7
PROOFLY_AUTH_REDIS_PREFIX=proofly

# RSA 密钥对：用于前后端密码加密传输
# 生成命令：openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#          openssl rsa -in private.pem -pubout -out public.pem
PROOFLY_AUTH_RSA_PUBLIC_KEY=
PROOFLY_AUTH_RSA_PRIVATE_KEY=

# ---------- 文件上传 ----------
SPRING_SERVLET_MULTIPART_MAX_FILE_SIZE=25MB
SPRING_SERVLET_MULTIPART_MAX_REQUEST_SIZE=25MB

# ---------- 业务 ----------
PROOFLY_REVIEW_BASE_URL=http://localhost:5173/review/
PROOFLY_BILLING_BASE_PRICE=29.00

# ---------- XPay（沙箱/真实） ----------
# 默认 mock 模式无需真实凭据；接入真实 XPay 时填入商家提供的数据
XPAY_APP_ID=mock_app_id
XPAY_APP_KEY=mock_app_key
XPAY_API_URL=http://localhost:8080/api/public/webhook/xpay